+// TestPolyPayWebhookHTTPStatus prevents business errors being acknowledged as successful webhook delivery.
+func TestPolyPayWebhookHTTPStatus(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	for _, tt := range []struct {
+		name, path string
+		err        error
+		want       int
+	}{{"success", "/?channel_id=1", nil, 200}, {"failed commit", "/?channel_id=1", errors.New("commit failed"), 503}, {"missing channel", "/", nil, 400}} {
+		t.Run(tt.name, func(t *testing.T) {
+			handler := NewWebhookHandler(nativeWebhookFixture{err: tt.err}, nil)
+			router := gin.New()
+			router.POST("/", handler.PolyPayWebhook)
+			w := httptest.NewRecorder()
+			router.ServeHTTP(w, httptest.NewRequest(http.MethodPost, tt.path, strings.NewReader(`{}`)))
+			if w.Code != tt.want {
+				t.Fatalf("got HTTP %d, want %d", w.Code, tt.want)
+			}
+		})
+	}
