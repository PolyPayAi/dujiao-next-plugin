+		if payment.Status != constants.PaymentStatusFailed && payment.Status != constants.PaymentStatusInitiated {
+			return ErrPaymentGatewayResponseInvalid
+		}
+		return nil
+	}
+	if result.Status == constants.PaymentStatusPending {
+		return ErrPaymentGatewayRequestFailed
+	}
+	_, err = s.HandleCallback(PaymentCallbackInput{PaymentID: payment.ID, ChannelID: channel.ID, Status: result.Status, ProviderRef: result.ProviderRef, Amount: result.Amount, Currency: result.Currency, PaidAt: result.PaidAt, Payload: result.Payload})
+	if err != nil {
+		return err
+	}
+	if result.Status == constants.PaymentStatusSuccess {
+		return ErrPaymentStatusInvalid
+	}
+	return nil
+}
