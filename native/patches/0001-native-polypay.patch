+++ b/internal/modules/payment/infrastructure/gateway/adapters/polypay/adapter.go
@@ -0,0 +1,174 @@
+package polypayadapter
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/dujiao-next/internal/cache"
+	"github.com/dujiao-next/internal/constants"
+	paymentcontract "github.com/dujiao-next/internal/modules/payment/contract"
+	gatewaycommon "github.com/dujiao-next/internal/modules/payment/infrastructure/gateway/common"
+	"github.com/dujiao-next/internal/modules/payment/infrastructure/gateway/polypay"
+	"github.com/dujiao-next/internal/shared/jsonmap"
+	"github.com/dujiao-next/internal/shared/money"
+	"github.com/shopspring/decimal"
+)
+
+type adapter struct{ client *polypay.Client }
+
+// NewPolyPayAdapter registers the native PolyPay provider with durable Redis replay prevention.
+func NewPolyPayAdapter() paymentcontract.GatewayProvider {
+	return &adapter{client: polypay.NewClient(nil, func(ctx context.Context, key string, ttl time.Duration) (bool, error) {
+		client := cache.Client()
+		if client == nil {
+			return false, cache.ErrUnavailable
+		}
+		return client.SetNX(ctx, key, "1", ttl).Result()
+	})}
+}
+
+// Type identifies the native provider without an EPay protocol wrapper.
+func (a *adapter) Type() string { return constants.PaymentProviderPolyPay + ":" }
+
+// ValidateConfig permits only the PolyPay hosted-checkout channel and redirect mode.
+func (a *adapter) ValidateConfig(raw jsonmap.JSON, channel string) error {
+	if channel != "" && channel != "polypay" && channel != constants.PaymentInteractionRedirect {
+		return paymentcontract.ErrGatewayUnsupportedChannel
+	}
+	_, err := polypay.ParseConfig(raw)
+	return err
+}
+
+// CreatePayment snapshots original accounting and the USD conversion submitted to PolyPay.
+func (a *adapter) CreatePayment(ctx context.Context, raw jsonmap.JSON, input paymentcontract.GatewayCreateInput) (*paymentcontract.GatewayCreateResult, error) {
+	cfg, err := polypay.ParseConfig(raw)
+	if err != nil {
+		return nil, err
+	}
+	if input.ChannelType != "polypay" {
+		return nil, paymentcontract.ErrGatewayUnsupportedChannel
+	}
+	if mode, _ := input.Extra["interaction_mode"].(string); mode != "" && mode != constants.PaymentInteractionRedirect {
+		return nil, paymentcontract.ErrGatewayConfigInvalid
+	}
+	snapshot, err := a.PreparePayment(raw, input)
+	if err != nil {
+		return nil, err
+	}
+	amount, _ := decimal.NewFromString(snapshot.AmountSent)
+	redirect := cfg.ReturnURL
+	if input.ReturnURL != "" {
+		redirect = input.ReturnURL
+	}
+	redirect = gatewaycommon.AppendQueryParams(redirect, input.ReturnURLQuery)
+	notify := gatewaycommon.AppendQueryParams(cfg.NotifyURL, map[string]string{"channel_id": fmt.Sprint(input.Extra["channel_id"])})
+	checkout, order, err := a.client.Checkout(ctx, cfg, input.OrderNo, amount.StringFixed(2), notify, redirect)
+	if err != nil {
+		return nil, err
+	}
+	actual, err := decimal.NewFromString(order.FiatAmount.String())
+	if err != nil || !actual.Equal(amount) {
+		return nil, paymentcontract.ErrGatewayResponseInvalid
+	}
+	snapshot.ProviderRef = order.TradeID
+	snapshot.RedirectURL = checkout
+	return snapshot, nil
+}
+
+// orderResult maps only authenticated remote states; manual recharge never authorizes a purchase.
+func orderResult(order *polypay.Order) (*paymentcontract.GatewayQueryResult, error) {
+	amount, err := parseUSD(order.FiatAmount.String())
+	if err != nil {
+		return nil, paymentcontract.ErrGatewayResponseInvalid
+	}
+	status := constants.PaymentStatusPending
+	switch order.Status {
+	case 2, 7:
+		status = constants.PaymentStatusSuccess
+	case 3, 4:
+		status = constants.PaymentStatusExpired
+	case 0, 1, 6:
+	default:
+		return nil, paymentcontract.ErrGatewayResponseInvalid
+	}
+	return &paymentcontract.GatewayQueryResult{ProviderRef: order.TradeID, Status: status, Amount: amount, Currency: "USD", Payload: jsonmap.JSON{"polypay_order_no": order.OrderNo}}, nil
+}
+
+// QueryPayment reconciles the actual attempt using its stored trade ID.
+func (a *adapter) QueryPayment(ctx context.Context, raw jsonmap.JSON, trade string) (*paymentcontract.GatewayQueryResult, error) {
+	cfg, err := polypay.ParseConfig(raw)
+	if err != nil {
+		return nil, err
+	}
+	order, err := a.client.Query(ctx, cfg, trade)
+	if err != nil {
+		return nil, err
+	}
+	return orderResult(order)
+}
+
+// CancelPayment cancels only pending attempts and reconciles ambiguous responses.
+func (a *adapter) CancelPayment(ctx context.Context, raw jsonmap.JSON, trade string) (*paymentcontract.GatewayQueryResult, error) {
+	cfg, err := polypay.ParseConfig(raw)
+	if err != nil {
+		return nil, err
+	}
+	order, err := a.client.Cancel(ctx, cfg, trade)
+	if errors.Is(err, polypay.ErrOrderNotFound) && strings.HasPrefix(trade, "merchant:") {
+		return &paymentcontract.GatewayQueryResult{Status: constants.PaymentStatusExpired, Payload: jsonmap.JSON{"polypay_attempt_absent": true}}, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	return orderResult(order)
+}
+
+// ParseWebhook verifies strict Ed25519 v2 and hands USD facts to the host's transactional fulfillment.
+func (a *adapter) ParseWebhook(ctx context.Context, raw jsonmap.JSON, headers map[string]string, body []byte, now time.Time) (*paymentcontract.GatewayCallbackResult, error) {
+	cfg, err := polypay.ParseConfig(raw)
+	if err != nil {
+		return nil, err
+	}
+	event, err := a.client.Verify(ctx, cfg, headers, body, now)
+	if err != nil {
+		return nil, err
+	}
+	if event.Status != 2 && event.Status != 7 {
+		return &paymentcontract.GatewayCallbackResult{}, nil
+	}
+	amount, err := parseUSD(event.FiatAmount.String())
+	if err != nil || !amount.Decimal.IsPositive() {
+		return nil, paymentcontract.ErrGatewayResponseInvalid
+	}
+	return &paymentcontract.GatewayCallbackResult{OrderNo: strings.TrimSpace(event.OrderNo), Status: constants.PaymentStatusSuccess, Amount: amount, Currency: "USD", Payload: jsonmap.JSON{"event_id": event.EventID, "environment": "production", "polypay_merchant_id": cfg.MerchantID}}, nil
+}
+
+var _ paymentcontract.GatewayWebhooker = (*adapter)(nil)
+var _ paymentcontract.GatewayCapturer = (*adapter)(nil)
+var _ paymentcontract.GatewayCanceller = (*adapter)(nil)
+
+// parseUSD validates the fixed fiat precision before constructing the host money value.
+func parseUSD(raw string) (money.Amount, error) {
+	value, err := decimal.NewFromString(raw)
+	if err != nil || !value.Equal(value.Round(2)) {
+		return money.Amount{}, paymentcontract.ErrGatewayResponseInvalid
+	}
+	return money.FromDecimal(value), nil
+}
+
+// PreparePayment fixes the conversion rate and original coverage before checkout leaves the process.
+func (a *adapter) PreparePayment(raw jsonmap.JSON, input paymentcontract.GatewayCreateInput) (*paymentcontract.GatewayCreateResult, error) {
+	cfg, err := polypay.ParseConfig(raw)
+	if err != nil {
+		return nil, err
+	}
+	rate, _ := decimal.NewFromString(cfg.USDRate)
+	amount := input.Amount.Decimal.Mul(rate).Round(2)
+	if !amount.IsPositive() {
+		return nil, paymentcontract.ErrGatewayConfigInvalid
+	}
+	return &paymentcontract.GatewayCreateResult{AmountSent: amount.StringFixed(2), CurrencySent: "USD", Payload: jsonmap.JSON{"exchange_rate": rate.String(), "original_amount": input.Amount.Decimal.StringFixed(2), "original_currency": input.Currency, "polypay_merchant_id": cfg.MerchantID, "polypay_order_no": input.OrderNo, paymentcontract.GatewayPayloadFiatCurrencySent: "USD"}}, nil
+}
