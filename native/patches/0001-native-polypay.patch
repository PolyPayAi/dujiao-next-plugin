+// CancelPendingGatewayPayments reconciles remote PolyPay attempts outside the order transaction.
+func (s *PaymentService) CancelPendingGatewayPayments(orderID uint) error {
+	payments, err := s.paymentRepo.ListByOrderID(orderID)
+	if err != nil {
+		return ErrPaymentUpdateFailed
+	}
+	for i := range payments {
+		if err := s.cancelPolyPayAttempt(&payments[i]); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// cancelPolyPayAttempt makes authenticated remote payment success win cancellation races.
+func (s *PaymentService) cancelPolyPayAttempt(payment *paymentdomain.Payment) error {
+	if payment.ProviderType != constants.PaymentProviderPolyPay || payment.Status == constants.PaymentStatusSuccess {
+		return nil
+	}
+	// A checkout request still in flight must finish before cancellation can prove remote closure.
+	if payment.Status == constants.PaymentStatusInitiated {
+		return ErrPaymentGatewayRequestFailed
+	}
+	ref := strings.TrimSpace(payment.ProviderRef)
+	if ref == "" {
+		ref = "merchant:" + strings.TrimSpace(payment.GatewayOrderNo)
+	}
+	if ref == "merchant:" {
+		return nil
+	} // No durable attempt was submitted.
+	channel, err := s.channelRepo.GetByID(payment.ChannelID)
+	if err != nil || channel == nil || s.paymentProviderRegistry == nil {
+		return ErrPaymentChannelNotFound
+	}
+	provider, ok := s.paymentProviderRegistry.Lookup(channel.ProviderType, channel.ChannelType)
+	if !ok {
+		return ErrPaymentProviderNotSupported
+	}
+	canceller, ok := provider.(paymentcontract.GatewayCanceller)
+	if !ok {
+		return ErrPaymentProviderNotSupported
+	}
