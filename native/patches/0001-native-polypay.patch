+)
+
+// TestFiatSnapshotAndRemoteStates verifies original coverage survives conversion and disallows recharge statuses.
+func TestFiatSnapshotAndRemoteStates(t *testing.T) {
+	a := NewPolyPayAdapter().(*adapter)
+	raw := jsonmap.JSON{"api_key": "synthetic", "merchant_id": "MCH-test", "usd_rate": "0.14", "notify_url": "https://store.test/hook", "return_url": "https://store.test/pay"}
+	snapshot, err := a.PreparePayment(raw, paymentcontract.GatewayCreateInput{OrderNo: "DJP-test", Currency: "CNY", Amount: money.FromDecimal(decimal.NewFromInt(88))})
+	if err != nil || snapshot.AmountSent != "12.32" || snapshot.CurrencySent != "USD" || snapshot.Payload["original_currency"] != "CNY" || snapshot.Payload["original_amount"] != "88.00" {
+		t.Fatalf("invalid snapshot %+v %v", snapshot, err)
+	}
+	for _, status := range []int{0, 1, 2, 3, 4, 5, 6, 7, 99} {
+		result, err := orderResult(&polypay.Order{TradeID: "trade", OrderNo: "DJP-test", Status: status, FiatAmount: json.Number("12.32")})
+		if status == 5 || status == 99 {
+			if err == nil {
+				t.Fatalf("unsafe status %d accepted", status)
+			}
+			continue
+		}
+		if err != nil || result.Amount.Decimal.StringFixed(2) != "12.32" {
+			t.Fatalf("status %d: %+v %v", status, result, err)
+		}
+	}
+}
diff --git a/internal/modules/payment/infrastructure/gateway/polypay/client.go b/internal/modules/payment/infrastructure/gateway/polypay/client.go
new file mode 100644
index 00000000..ae7fbda8
--- /dev/null
+++ b/internal/modules/payment/infrastructure/gateway/polypay/client.go
@@ -0,0 +1,162 @@
+package polypay
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+	"sync"
+	"time"
+
+	paymentcontract "github.com/dujiao-next/internal/modules/payment/contract"
+)
+
+// ErrOrderNotFound is returned only for the authenticated merchant API code 10006.
+var ErrOrderNotFound = errors.New("PolyPay order not found")
+
+// NonceConsumer atomically consumes an authenticated delivery nonce for its validity window.
+type NonceConsumer func(context.Context, string, time.Duration) (bool, error)
+
+// Client implements canonical merchant APIs and strict Ed25519 Webhook v2 verification.
+type Client struct {
+	http      *http.Client
+	consume   NonceConsumer
+	mu        sync.Mutex
+	keys      map[string][]byte
+	keysUntil time.Time
+}
+
+// NewClient binds a bounded HTTPS transport and a durable replay-prevention implementation.
+func NewClient(client *http.Client, consume NonceConsumer) *Client {
+	if client == nil {
+		client = &http.Client{Timeout: 15 * time.Second, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+	}
+	return &Client{http: client, consume: consume}
+}
+
+// Order is an authenticated server order snapshot; fiat amounts are USD, never token quantities.
+type Order struct {
+	TradeID     string      `json:"trade_id"`
+	OrderNo     string      `json:"mch_order_id"`
+	Status      int         `json:"status"`
+	Environment string      `json:"environment"`
+	FiatAmount  json.Number `json:"fiat_amount"`
+}
+
+// request performs a bounded merchant request without reflecting keys or response bodies into errors.
+func (c *Client) request(ctx context.Context, cfg *Config, operation string, input any, output any) error {
+	body, err := json.Marshal(input)
+	if err != nil {
+		return paymentcontract.ErrGatewayRequestFailed
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, APIBaseURL+"/order/"+operation, bytes.NewReader(body))
+	if err != nil {
+		return paymentcontract.ErrGatewayRequestFailed
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("X-API-Key", cfg.APIKey)
+	res, err := c.http.Do(req)
+	if err != nil {
+		return paymentcontract.ErrGatewayRequestFailed
+	}
+	defer res.Body.Close()
+	if res.StatusCode < 200 || res.StatusCode >= 300 {
+		return paymentcontract.ErrGatewayRequestFailed
+	}
+	var envelope struct {
+		Code int             `json:"code"`
+		Data json.RawMessage `json:"data"`
+	}
+	data, err := io.ReadAll(io.LimitReader(res.Body, (1<<20)+1))
+	if err != nil || len(data) > 1<<20 || json.Unmarshal(data, &envelope) != nil {
+		return paymentcontract.ErrGatewayResponseInvalid
+	}
+	if envelope.Code == 10006 {
+		return ErrOrderNotFound
+	}
+	if envelope.Code != 0 {
+		return fmt.Errorf("%w: PolyPay code %d", paymentcontract.ErrGatewayRequestFailed, envelope.Code)
+	}
+	if output != nil && json.Unmarshal(envelope.Data, output) != nil {
+		return paymentcontract.ErrGatewayResponseInvalid
+	}
+	return nil
+}
+
+// Checkout creates an idempotent merchant attempt and resolves its authoritative trade identifier.
+func (c *Client) Checkout(ctx context.Context, cfg *Config, orderNo, amount, notify, redirect string) (string, *Order, error) {
+	if len(orderNo) == 0 || len(orderNo) > 32 {
+		return "", nil, paymentcontract.ErrGatewayConfigInvalid
+	}
+	if err := cfg.ValidateURL(notify); err != nil {
+		return "", nil, err
+	}
+	if err := cfg.ValidateURL(redirect); err != nil {
+		return "", nil, err
+	}
+	var checkout struct {
+		URL string `json:"checkout_url"`
+	}
+	if err := c.request(ctx, cfg, "checkout", map[string]string{"mch_order_id": orderNo, "amount": amount, "notify_url": notify, "redirect_url": redirect}, &checkout); err != nil {
+		return "", nil, err
+	}
+	parsed, err := url.Parse(checkout.URL)
+	if err != nil || parsed.Scheme != "https" || parsed.Hostname() == "" || parsed.User != nil {
+		return "", nil, paymentcontract.ErrGatewayResponseInvalid
+	}
+	var order Order
+	if err := c.request(ctx, cfg, "detail", map[string]string{"mch_order_id": orderNo}, &order); err != nil {
+		return "", nil, err
+	}
+	if order.TradeID == "" || order.OrderNo != orderNo || order.Environment != "production" {
+		return "", nil, paymentcontract.ErrGatewayResponseInvalid
+	}
+	return checkout.URL, &order, nil
+}
+
+// Query retrieves a payment attempt using its actual PolyPay trade ID.
+func (c *Client) Query(ctx context.Context, cfg *Config, trade string) (*Order, error) {
+	if trade == "" {
+		return nil, paymentcontract.ErrGatewayConfigInvalid
+	}
+	var order Order
+	query := map[string]string{"trade_id": trade}
+	merchantNo, byMerchant := strings.CutPrefix(trade, "merchant:")
+	if byMerchant {
+		query = map[string]string{"mch_order_id": merchantNo}
+	}
+	if err := c.request(ctx, cfg, "detail", query, &order); err != nil {
+		return nil, err
+	}
+	if order.TradeID == "" || (!byMerchant && order.TradeID != trade) || (byMerchant && order.OrderNo != merchantNo) || order.OrderNo == "" || order.Environment != "production" {
+		return nil, paymentcontract.ErrGatewayResponseInvalid
+	}
+	return &order, nil
+}
+
+// Cancel reconciles before and after cancellation so paid orders always win a race.
+func (c *Client) Cancel(ctx context.Context, cfg *Config, trade string) (*Order, error) {
+	order, err := c.Query(ctx, cfg, trade)
+	if err != nil {
+		return nil, err
+	}
+	if order.Status == 0 || order.Status == 1 {
+		cancelErr := c.request(ctx, cfg, "cancel", map[string]string{"trade_id": order.TradeID}, nil)
+		order, err = c.Query(ctx, cfg, trade)
+		if err != nil {
+			return nil, err
+		}
+		if order.Status == 0 || order.Status == 1 {
+			if cancelErr != nil {
+				return nil, cancelErr
+			}
+			return nil, paymentcontract.ErrGatewayRequestFailed
+		}
+	}
+	return order, nil
+}
diff --git a/internal/modules/payment/infrastructure/gateway/polypay/client_test.go b/internal/modules/payment/infrastructure/gateway/polypay/client_test.go
new file mode 100644
index 00000000..e457558f
--- /dev/null
+++ b/internal/modules/payment/infrastructure/gateway/polypay/client_test.go
@@ -0,0 +1,190 @@
+package polypay
+
+import (
+	"context"
+	"crypto/ed25519"
+	"crypto/rand"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/dujiao-next/internal/shared/jsonmap"
+)
+
+type rewriteTransport struct {
+	base   http.RoundTripper
+	target *url.URL
+}
+
+// RoundTrip keeps the production-origin assertion while routing tests to a TLS fixture.
+func (r rewriteTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	if req.URL.Scheme != "https" || req.URL.Host != "api.polypay.ai" {
+		return nil, fmt.Errorf("unexpected API origin")
+	}
+	clone := req.Clone(req.Context())
+	clone.URL.Scheme = r.target.Scheme
+	clone.URL.Host = r.target.Host
+	return r.base.RoundTrip(clone)
+}
+
+// fixtureClient creates an isolated TLS API without exposing a configurable production API origin.
+func fixtureClient(t *testing.T, handler http.HandlerFunc, consume NonceConsumer) *Client {
+	t.Helper()
+	server := httptest.NewTLSServer(handler)
+	t.Cleanup(server.Close)
+	target, _ := url.Parse(server.URL)
+	client := server.Client()
+	client.Transport = rewriteTransport{client.Transport, target}
+	return NewClient(client, consume)
+}
+
+// testConfig contains synthetic credentials only.
+func testConfig() *Config {
+	disabled := false
+	return &Config{APIKey: "test-key", MerchantID: "MCH-test", USDRate: "0.14", NotifyURL: "http://192.168.1.2/callback", ReturnURL: "http://192.168.1.2/pay", ForceHTTPS: &disabled}
+}
+
+// TestCheckoutAndCancelRace proves that a paid result overrides an ambiguous cancel response.
+func TestCheckoutAndCancelRace(t *testing.T) {
+	for _, paid := range []bool{false, true} {
+		t.Run(fmt.Sprint(paid), func(t *testing.T) {
+			status := 0
+			client := fixtureClient(t, func(w http.ResponseWriter, r *http.Request) {
+				if r.Header.Get("X-API-Key") != "test-key" {
+					t.Error("missing API authentication")
+				}
+				var input map[string]string
+				if err := json.NewDecoder(r.Body).Decode(&input); err != nil {
+					t.Error(err)
+				}
+				switch r.URL.Path {
+				case "/api/v1/pay/order/checkout":
+					if input["amount"] != "1.40" || input["mch_order_id"] != "DJP-test" {
+						t.Error("wrong checkout accounting")
+					}
+					io.WriteString(w, `{"code":0,"data":{"checkout_url":"https://pay.polypay.ai/test"}}`)
+				case "/api/v1/pay/order/detail":
+					fmt.Fprintf(w, `{"code":0,"data":{"trade_id":"trade-test","mch_order_id":"DJP-test","status":%d,"fiat_amount":"1.40","environment":"production"}}`, status)
+				case "/api/v1/pay/order/cancel":
+					if input["trade_id"] != "trade-test" {
+						t.Error("cancel did not resolve actual trade ID")
+					}
+					status = 4
+					if paid {
+						status = 2
+					}
+					w.WriteHeader(503)
+				default:
+					t.Errorf("unexpected path %s", r.URL.Path)
+					w.WriteHeader(404)
+				}
+			}, nil)
+			_, order, err := client.Checkout(context.Background(), testConfig(), "DJP-test", "1.40", testConfig().NotifyURL, testConfig().ReturnURL)
+			if err != nil || order.TradeID != "trade-test" {
+				t.Fatalf("checkout: %v %+v", err, order)
+			}
+			result, err := client.Cancel(context.Background(), testConfig(), "merchant:DJP-test")
+			want := 4
+			if paid {
+				want = 2
+			}
+			if err != nil || result.Status != want {
+				t.Fatalf("cancel state: %v %+v", err, result)
+			}
+		})
+	}
+}
+
+// TestWebhookV2 verifies exact raw bytes, freshness, audience, key rotation and durable replay prevention.
+func TestWebhookV2(t *testing.T) {
+	pub, priv, _ := ed25519.GenerateKey(rand.Reader)
+	pub2, priv2, _ := ed25519.GenerateKey(rand.Reader)
+	var mu sync.Mutex
+	nonces := map[string]bool{}
+	unavailable := false
+	requests := 0
+	client := fixtureClient(t, func(w http.ResponseWriter, r *http.Request) {
+		requests++
+		if r.URL.Path != "/api/v1/pay/public/webhook-jwks" || r.Header.Get("X-API-Key") != "" {
+			t.Error("invalid public key request")
+		}
+		id, key := "key-1", pub
+		if requests > 1 {
+			id, key = "key-2", pub2
+		}
+		fmt.Fprintf(w, `{"code":0,"data":{"keys":[{"kty":"OKP","crv":"Ed25519","alg":"EdDSA","use":"sig","kid":%q,"x":%q}]}}`, id, base64.RawURLEncoding.EncodeToString(key))
+	}, func(_ context.Context, key string, ttl time.Duration) (bool, error) {
+		mu.Lock()
+		defer mu.Unlock()
+		if unavailable {
+			return false, fmt.Errorf("redis unavailable")
+		}
+		if ttl != 10*time.Minute {
+			t.Error("incorrect nonce TTL")
+		}
+		if nonces[key] {
+			return false, nil
+		}
+		nonces[key] = true
+		return true, nil
+	})
+	now := time.Now().Truncate(time.Second)
+	body := []byte(`{"order_no":"DJP-test","event_id":"evt-test","status":2,"fiat_amount":1.40,"amount":"999999","environment":"production"}`)
+	sign := func(id, nonce string, key ed25519.PrivateKey) map[string]string {
+		stamp := strconv.FormatInt(now.Unix(), 10)
+		text := strings.Join([]string{"polypay-webhook-v2", id, stamp, nonce, "MCH-test", "production", string(body)}, "\n")
+		return map[string]string{"X-Webhook-Signature-Version": "v2", "X-Webhook-Key-Id": id, "X-Timestamp": stamp, "X-Nonce": nonce, "X-Webhook-Merchant-Id": "MCH-test", "X-Webhook-Environment": "production", "X-Webhook-Signature-V2": base64.RawURLEncoding.EncodeToString(ed25519.Sign(key, []byte(text)))}
+	}
+	valid := sign("key-1", "0123456789abcdef", priv)
+	if _, err := client.Verify(context.Background(), testConfig(), valid, append(append([]byte{}, body...), ' '), now); err == nil {
+		t.Fatal("tampered bytes accepted")
+	}
+	wrong := sign("key-1", "1123456789abcdef", priv)
+	wrong["X-Webhook-Merchant-Id"] = "other"
+	if _, err := client.Verify(context.Background(), testConfig(), wrong, body, now); err == nil {
+		t.Fatal("wrong merchant accepted")
+	}
+	if _, err := client.Verify(context.Background(), testConfig(), valid, body, now.Add(301*time.Second)); err == nil {
+		t.Fatal("expired signature accepted")
+	}
+	event, err := client.Verify(context.Background(), testConfig(), valid, body, now)
+	if err != nil || event.FiatAmount.String() != "1.40" {
+		t.Fatalf("valid event: %v %+v", err, event)
+	}
+	if _, err := client.Verify(context.Background(), testConfig(), valid, body, now); err == nil {
+		t.Fatal("replay accepted")
+	}
+	rotated := sign("key-2", "2123456789abcdef", priv2)
+	if _, err := client.Verify(context.Background(), testConfig(), rotated, body, now); err != nil {
+		t.Fatalf("rotation: %v", err)
+	}
+	unavailable = true
+	if _, err := client.Verify(context.Background(), testConfig(), sign("key-2", "3123456789abcdef", priv2), body, now); err == nil {
+		t.Fatal("missing replay store accepted")
+	}
+}
+
+// TestHTTPRequiresExplicitSwitch ensures LAN HTTP is intentional and never changes the API origin.
+func TestHTTPRequiresExplicitSwitch(t *testing.T) {
+	raw := jsonmap.JSON{"api_key": "synthetic", "merchant_id": "MCH-test", "usd_rate": "0.14", "notify_url": "http://192.168.1.2/hook", "return_url": "http://192.168.1.2/pay"}
+	if _, err := ParseConfig(raw); err == nil {
+		t.Fatal("HTTP accepted by default")
+	}
+	raw["force_https"] = false
+	if _, err := ParseConfig(raw); err != nil {
+		t.Fatal(err)
+	}
+	raw["usd_rate"] = "0"
+	if _, err := ParseConfig(raw); err == nil {
+		t.Fatal("zero conversion accepted")
+	}
+}
diff --git a/internal/modules/payment/infrastructure/gateway/polypay/config.go b/internal/modules/payment/infrastructure/gateway/polypay/config.go
new file mode 100644
index 00000000..0f14e2d3
--- /dev/null
+++ b/internal/modules/payment/infrastructure/gateway/polypay/config.go
@@ -0,0 +1,58 @@
+package polypay
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/url"
+	"strings"
+
+	paymentcontract "github.com/dujiao-next/internal/modules/payment/contract"
+	"github.com/dujiao-next/internal/shared/jsonmap"
+	"github.com/shopspring/decimal"
+)
+
+const APIBaseURL = "https://api.polypay.ai/api/v1/pay"
+
+// Config contains server-only merchant credentials and storefront callback settings.
+type Config struct {
+	APIKey     string `json:"api_key"`
+	MerchantID string `json:"merchant_id"`
+	USDRate    string `json:"usd_rate"`
+	NotifyURL  string `json:"notify_url"`
+	ReturnURL  string `json:"return_url"`
+	ForceHTTPS *bool  `json:"force_https"`
+}
+
+// ParseConfig rejects incomplete merchant settings without changing environments.
+func ParseConfig(raw jsonmap.JSON) (*Config, error) {
+	data, err := json.Marshal(raw)
+	if err != nil {
+		return nil, paymentcontract.ErrGatewayConfigInvalid
+	}
+	var cfg Config
+	if json.Unmarshal(data, &cfg) != nil {
+		return nil, paymentcontract.ErrGatewayConfigInvalid
+	}
+	cfg.APIKey = strings.TrimSpace(cfg.APIKey)
+	cfg.MerchantID = strings.TrimSpace(cfg.MerchantID)
+	rate, err := decimal.NewFromString(cfg.USDRate)
+	if cfg.APIKey == "" || cfg.MerchantID == "" || err != nil || !rate.IsPositive() {
+		return nil, paymentcontract.ErrGatewayConfigInvalid
+	}
+	for _, target := range []string{cfg.NotifyURL, cfg.ReturnURL} {
+		if err := cfg.ValidateURL(target); err != nil {
+			return nil, err
+		}
+	}
+	return &cfg, nil
+}
+
+// ValidateURL permits HTTP only when the merchant explicitly disables Force HTTPS.
+func (c Config) ValidateURL(raw string) error {
+	parsed, err := url.Parse(raw)
+	force := c.ForceHTTPS == nil || *c.ForceHTTPS
+	if err != nil || parsed.Hostname() == "" || parsed.User != nil || parsed.Fragment != "" || strings.ContainsAny(raw, "\r\n\t\\ ") || !(parsed.Scheme == "https" || (!force && parsed.Scheme == "http")) {
+		return fmt.Errorf("%w: invalid storefront URL or HTTPS requirement", paymentcontract.ErrGatewayConfigInvalid)
+	}
+	return nil
+}
diff --git a/internal/modules/payment/infrastructure/gateway/polypay/webhook.go b/internal/modules/payment/infrastructure/gateway/polypay/webhook.go
new file mode 100644
index 00000000..726d90b1
--- /dev/null
+++ b/internal/modules/payment/infrastructure/gateway/polypay/webhook.go
@@ -0,0 +1,134 @@
+package polypay
+
+import (
+	"context"
+	"crypto/ed25519"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"io"
+	"net/http"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+
+	paymentcontract "github.com/dujiao-next/internal/modules/payment/contract"
+)
+
+var keyIDPattern = regexp.MustCompile(`^[A-Za-z0-9._-]{1,64}$`)
+var noncePattern = regexp.MustCompile(`^[A-Za-z0-9]{16,128}$`)
+var timestampPattern = regexp.MustCompile(`^[0-9]{1,12}$`)
+
+// Event carries only the verified fields needed for host payment accounting.
+type Event struct {
+	OrderNo     string      `json:"order_no"`
+	Status      int         `json:"status"`
+	FiatAmount  json.Number `json:"fiat_amount"`
+	Environment string      `json:"environment"`
+	EventID     string      `json:"event_id"`
+}
+
+// publicKey refreshes fixed-origin JWKS on expiry or an unknown signing key.
+func (c *Client) publicKey(ctx context.Context, id string, now time.Time) (ed25519.PublicKey, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if key := c.keys[id]; len(key) == ed25519.PublicKeySize && now.Before(c.keysUntil) {
+		return ed25519.PublicKey(key), nil
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, APIBaseURL+"/public/webhook-jwks", nil)
+	if err != nil {
+		return nil, paymentcontract.ErrGatewayRequestFailed
+	}
+	res, err := c.http.Do(req)
+	if err != nil {
+		return nil, paymentcontract.ErrGatewayRequestFailed
+	}
+	defer res.Body.Close()
+	if res.StatusCode != http.StatusOK {
+		return nil, paymentcontract.ErrGatewayRequestFailed
+	}
+	type jwk struct {
+		Kty string `json:"kty"`
+		Crv string `json:"crv"`
+		Alg string `json:"alg"`
+		Use string `json:"use"`
+		Kid string `json:"kid"`
+		X   string `json:"x"`
+	}
+	var doc struct {
+		Keys []jwk `json:"keys"`
+		Data struct {
+			Keys []jwk `json:"keys"`
+		} `json:"data"`
+	}
+	data, err := io.ReadAll(io.LimitReader(res.Body, 65537))
+	if err != nil || len(data) > 65536 || json.Unmarshal(data, &doc) != nil {
+		return nil, paymentcontract.ErrGatewayResponseInvalid
+	}
+	keys := doc.Keys
+	if len(keys) == 0 {
+		keys = doc.Data.Keys
+	}
+	validated := map[string][]byte{}
+	for _, key := range keys {
+		decoded, err := base64.RawURLEncoding.Strict().DecodeString(key.X)
+		if err == nil && key.Kty == "OKP" && key.Crv == "Ed25519" && key.Alg == "EdDSA" && key.Use == "sig" && keyIDPattern.MatchString(key.Kid) && len(decoded) == ed25519.PublicKeySize {
+			validated[key.Kid] = decoded
+		}
+	}
+	if len(validated) == 0 {
+		return nil, paymentcontract.ErrGatewayResponseInvalid
+	}
+	c.keys = validated
+	c.keysUntil = now.Add(5 * time.Minute)
+	if key := c.keys[id]; len(key) == ed25519.PublicKeySize {
+		return ed25519.PublicKey(key), nil
+	}
+	return nil, paymentcontract.ErrGatewaySignatureInvalid
+}
+
+// Verify authenticates the raw-body v2 audience, freshness and durable nonce before decoding the event.
+func (c *Client) Verify(ctx context.Context, cfg *Config, headers map[string]string, body []byte, now time.Time) (*Event, error) {
+	h := map[string]string{}
+	for k, v := range headers {
+		h[strings.ToLower(k)] = strings.TrimSpace(v)
+	}
+	id, stamp, nonce := h["x-webhook-key-id"], h["x-timestamp"], h["x-nonce"]
+	if len(body) > 1<<20 || h["x-webhook-signature-version"] != "v2" || !keyIDPattern.MatchString(id) || !timestampPattern.MatchString(stamp) || !noncePattern.MatchString(nonce) || h["x-webhook-merchant-id"] != cfg.MerchantID || h["x-webhook-environment"] != "production" {
+		return nil, paymentcontract.ErrGatewaySignatureInvalid
+	}
+	seconds, err := strconv.ParseInt(stamp, 10, 64)
+	if err != nil || now.Sub(time.Unix(seconds, 0)).Abs() > 5*time.Minute {
+		return nil, paymentcontract.ErrGatewaySignatureInvalid
+	}
+	sig, err := base64.RawURLEncoding.Strict().DecodeString(h["x-webhook-signature-v2"])
+	if err != nil || len(sig) != ed25519.SignatureSize {
+		return nil, paymentcontract.ErrGatewaySignatureInvalid
+	}
+	key, err := c.publicKey(ctx, id, now)
+	if err != nil {
+		return nil, err
+	}
+	canonical := strings.Join([]string{"polypay-webhook-v2", id, stamp, nonce, cfg.MerchantID, "production", string(body)}, "\n")
+	if !ed25519.Verify(key, []byte(canonical), sig) {
+		return nil, paymentcontract.ErrGatewaySignatureInvalid
+	}
+	var event Event
+	if json.Unmarshal(body, &event) != nil || event.OrderNo == "" || event.EventID == "" || event.Environment != "production" {
+		return nil, paymentcontract.ErrGatewayResponseInvalid
+	}
+	if c.consume == nil {
+		return nil, paymentcontract.ErrGatewayRequestFailed
+	}
+	digest := sha256.Sum256([]byte("v2|" + id + "|" + stamp + "|" + nonce))
+	consumed, err := c.consume(ctx, "polypay:webhook:"+hex.EncodeToString(digest[:]), 10*time.Minute)
+	if err != nil {
+		return nil, paymentcontract.ErrGatewayRequestFailed
+	}
+	if !consumed {
+		return nil, paymentcontract.ErrGatewaySignatureInvalid
+	}
+	return &event, nil
+}
