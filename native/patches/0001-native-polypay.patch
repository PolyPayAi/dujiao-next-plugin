+// PolyPayWebhook acknowledges only verified, committed processing with real HTTP status codes.
+func (h *WebhookHandler) PolyPayWebhook(c *gin.Context) {
+	var query PaypalWebhookQuery
+	if c.ShouldBindQuery(&query) != nil {
+		c.Status(http.StatusBadRequest)
+		return
+	}
+	body, err := readWebhookBody(c)
+	if err != nil {
+		c.Status(http.StatusRequestEntityTooLarge)
+		return
+	}
+	_, _, err = h.webhooks.HandlePolyPayWebhook(WebhookCallbackInput{ChannelID: query.ChannelID, Headers: collectRequestHeaders(c), Body: body, Context: c.Request.Context()})
+	if err != nil {
+		ginutil.RequestLog(c).Warnw("polypay_webhook_rejected", "channel_id", query.ChannelID, "error", err)
+		c.Status(http.StatusServiceUnavailable)
+		return
+	}
+	c.String(http.StatusOK, "OK")
+}
