 .../gateway/adapters/polypay/adapter_test.go  | 91 ++++++++++++++++++-
 .../infrastructure/gateway/polypay/client.go  |  3 +
 3 files changed, 119 insertions(+), 5 deletions(-)

diff --git a/internal/modules/payment/infrastructure/gateway/adapters/polypay/adapter.go b/internal/modules/payment/infrastructure/gateway/adapters/polypay/adapter.go
index c98a28c1..5e5d39b7 100644
--- a/internal/modules/payment/infrastructure/gateway/adapters/polypay/adapter.go
+++ b/internal/modules/payment/infrastructure/gateway/adapters/polypay/adapter.go
@@ -69,8 +69,8 @@ func (a *adapter) CreatePayment(ctx context.Context, raw jsonmap.JSON, input pay
 	if err != nil {
 		return nil, err
 	}
-	actual, err := decimal.NewFromString(order.FiatAmount.String())
-	if err != nil || !actual.Equal(amount) {
+	actual, err := orderUSD(order)
+	if err != nil || !actual.Decimal.Equal(amount) {
 		return nil, paymentcontract.ErrGatewayResponseInvalid
 	}
 	snapshot.ProviderRef = order.TradeID
@@ -80,7 +80,7 @@ func (a *adapter) CreatePayment(ctx context.Context, raw jsonmap.JSON, input pay
 
 // orderResult maps only authenticated remote states; manual recharge never authorizes a purchase.
 func orderResult(order *polypay.Order) (*paymentcontract.GatewayQueryResult, error) {
-	amount, err := parseUSD(order.FiatAmount.String())
+	amount, err := orderUSD(order)
 	if err != nil {
 		return nil, paymentcontract.ErrGatewayResponseInvalid
 	}
@@ -153,7 +153,7 @@ var _ paymentcontract.GatewayCanceller = (*adapter)(nil)
 // parseUSD validates the fixed fiat precision before constructing the host money value.
 func parseUSD(raw string) (money.Amount, error) {
 	value, err := decimal.NewFromString(raw)
-	if err != nil || !value.Equal(value.Round(2)) {
+	if err != nil || !value.IsPositive() || !value.Equal(value.Round(2)) {
 		return money.Amount{}, paymentcontract.ErrGatewayResponseInvalid
 	}
 	return money.FromDecimal(value), nil
@@ -172,3 +172,25 @@ func (a *adapter) PreparePayment(raw jsonmap.JSON, input paymentcontract.Gateway
 	}
 	return &paymentcontract.GatewayCreateResult{AmountSent: amount.StringFixed(2), CurrencySent: "USD", Payload: jsonmap.JSON{"exchange_rate": rate.String(), "original_amount": input.Amount.Decimal.StringFixed(2), "original_currency": input.Currency, "polypay_merchant_id": cfg.MerchantID, "polypay_order_no": input.OrderNo, paymentcontract.GatewayPayloadFiatCurrencySent: "USD"}}, nil
 }
+
+// orderUSD follows the API state machine: unselected checkout Amount is USD;
+// once a method is selected, Amount is a token quantity and only FiatAmount is USD.
+// Closing an unselected checkout retains its original USD Amount and empty method.
+func orderUSD(order *polypay.Order) (money.Amount, error) {
+	if order == nil {
+		return money.Amount{}, paymentcontract.ErrGatewayResponseInvalid
+	}
+	unselected := order.Currency == "" && order.Network == ""
+	switch order.Status {
+	case 0:
+		if !unselected {
+			return money.Amount{}, paymentcontract.ErrGatewayResponseInvalid
+		}
+		return parseUSD(order.Amount.String())
+	case 3, 4:
+		if unselected {
+			return parseUSD(order.Amount.String())
+		}
+	}
+	return parseUSD(order.FiatAmount.String())
+}
