+
+type checkoutFixtureTransport struct {
+	base   http.RoundTripper
+	target *url.URL
+}
+
+// RoundTrip routes the fixed production endpoint to a local TLS contract fixture.
+func (r checkoutFixtureTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	clone := req.Clone(req.Context())
+	clone.URL.Scheme = r.target.Scheme
+	clone.URL.Host = r.target.Host
+	return r.base.RoundTrip(clone)
+}
+
+// TestHostedCheckoutUnselectedAmount exercises actual create/query/cancel responses before method selection.
+func TestHostedCheckoutUnselectedAmount(t *testing.T) {
+	for _, wrongAmount := range []bool{false, true} {
+		t.Run(fmt.Sprint(wrongAmount), func(t *testing.T) {
+			status := 0
+			server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				switch r.URL.Path {
+				case "/api/v1/pay/order/checkout":
+					io.WriteString(w, `{"code":0,"data":{"checkout_url":"https://checkout.polypay.ai/pay/trade-test"}}`)
+				case "/api/v1/pay/order/detail":
+					total := "0.14"
+					if wrongAmount {
+						total = "0.15"
+					}
+					fmt.Fprintf(w, `{"code":0,"data":{"mch_id":"MCH-test","trade_id":"trade-test","mch_order_id":"DJP-test","environment":"production","status":%d,"fiat_amount":0,"amount":%s,"currency":"","network":""}}`, status, total)
+				case "/api/v1/pay/order/cancel":
+					status = 4
+					io.WriteString(w, `{"code":0,"data":{}}`)
+				default:
+					w.WriteHeader(404)
+				}
+			}))
+			defer server.Close()
+			transport := server.Client()
+			target, _ := url.Parse(server.URL)
+			transport.Transport = checkoutFixtureTransport{transport.Transport, target}
+			a := &adapter{client: polypay.NewClient(transport, nil)}
+			raw := jsonmap.JSON{"api_key": "synthetic", "merchant_id": "MCH-test", "usd_rate": "0.14", "notify_url": "http://192.168.1.2/hook", "return_url": "http://192.168.1.2/pay", "force_https": false}
+			result, err := a.CreatePayment(context.Background(), raw, paymentcontract.GatewayCreateInput{OrderNo: "DJP-test", Amount: money.FromDecimal(decimal.NewFromInt(1)), Currency: "CNY", ChannelType: "polypay", Extra: jsonmap.JSON{"channel_id": uint(1)}})
+			if wrongAmount {
+				if err == nil {
+					t.Fatal("mismatched checkout USD accepted")
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("hosted checkout rejected before choosing a method: %v", err)
+			}
+			if result.AmountSent != "0.14" || result.CurrencySent != "USD" || result.ProviderRef != "trade-test" {
+				t.Fatal("incorrect checkout snapshot")
+			}
+			pending, err := a.QueryPayment(context.Background(), raw, result.ProviderRef)
+			if err != nil || pending.Status != "pending" || pending.Amount.Decimal.StringFixed(2) != "0.14" {
+				t.Fatalf("pending query: %+v %v", pending, err)
+			}
+			closed, err := a.CancelPayment(context.Background(), raw, result.ProviderRef)
+			if err != nil || closed.Status != "expired" || closed.Amount.Decimal.StringFixed(2) != "0.14" {
+				t.Fatalf("unselected cancellation: %+v %v", closed, err)
+			}
+		})
+	}
+}
+
+// TestPaidTokenAmountNeverSubstitutesFiat prevents token quantities from authorizing a USD purchase.
+func TestPaidTokenAmountNeverSubstitutesFiat(t *testing.T) {
+	for _, status := range []int{1, 2, 6, 7} {
+		_, err := orderResult(&polypay.Order{Status: status, FiatAmount: json.Number("0"), Amount: json.Number("1000"), Currency: "ETH", Network: "ethereum"})
+		if err == nil {
+			t.Fatalf("token amount accepted as USD for status %d", status)
+		}
+	}
+}
